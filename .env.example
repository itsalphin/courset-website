# Copy to .env / .env.local and fill in. NEVER commit the filled-in file.
# Generate strong secrets with: openssl rand -hex <bytes>

# ── Required ──
DATABASE_URL=file:./dev.db                 # Turso libsql://... in production
DATABASE_AUTH_TOKEN=                        # Turso token (production only)
JWT_ACCESS_SECRET=                          # openssl rand -hex 64
FIELD_ENCRYPTION_KEY=                       # openssl rand -hex 32  (32 bytes = 64 hex chars)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (transactional) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@yourdomain.com

# ── Rate limiting (shared store) ──
# Without these, rate limiting falls back to per-instance in-memory limits,
# which are weak on serverless (each instance counts separately). Provision an
# Upstash Redis database and set both for correct cross-instance enforcement.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NODE_ENV=development
